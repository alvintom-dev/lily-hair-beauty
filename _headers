# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

# Images and logo files are versioned by filename (-400/-800/-1200, -220/-440),
# so a changed file always means a changed URL. Safe to cache for a year.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself carries all markup, CSS and JS, so it must always revalidate
# or an edit stays invisible until the CDN copy expires. "/" is extensionless,
# so it needs its own rule — /*.html never matches a directory index.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The site is one static page with no login and no user input that reaches a
# server, so these can be strict.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
